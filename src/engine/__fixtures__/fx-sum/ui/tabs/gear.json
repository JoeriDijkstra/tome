            "toggle_equipped"
          ]
        },
        "empty": "Nothing carried.",
        "add": "add_gear"
      },
      {
        "widget": "list",
        "title": "Owned",
        "source": "@owned",
        "style": "cards",
        "row": {
          "title": "{$v.name}"
        }
      }
    ]
  }
]
