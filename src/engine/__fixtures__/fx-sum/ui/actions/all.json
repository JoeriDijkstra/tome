[
  {
    "id": "take_damage",
    "label": "Damage",
    "modal": "damage",
    "style": "danger"
  },
  {
    "id": "level_up",
    "label": "Level up",
    "modal": "level_up"
  },
  {
    "id": "long_rest",
    "label": "Long rest",
    "effects": [
      {
        "op": "reset",
        "tag": "long_rest"
      },
      {
        "op": "reset",
        "tag": "short_rest"
      }
    ],
    "confirm": {
      "title": "Take a long rest?",
      "message": "Restores vigor and Second Breath."
    }
  },
  {
    "id": "use_second_breath",
    "label": "Second Breath",
    "enabled_when": "@res.second_breath.current > 0",
    "effects": [
      {
        "op": "add",
        "path": "res.second_breath.current",
        "value": -1,
        "min": 0
      }
    ]
  },
  {
    "id": "heal",
    "label": "Heal",
    "modal": "heal"
  },
  {
    "id": "toggle_equipped",
    "label": "{$v.equipped ? 'Unequip' : 'Equip'}",
    "effects": [
      {
        "op": "toggle",
        "path": "gear[$k].equipped"
      }
    ]
  },
  {
    "id": "add_gear",
    "label": "Add gear",
    "effects": [
      {
        "op": "choose",
        "from": {
          "entity_type": "gear"
        },
        "count": 1,
        "then": [
          {
            "op": "push",
            "path": "gear",
            "value": "{item: $choice[0], equipped: false}"
          }
        ]
      }
    ]
  }
]
