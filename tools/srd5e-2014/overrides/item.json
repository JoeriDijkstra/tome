{
  "ring_of_protection": {
    "summary": "+1 AC and saving throws",
    "modifiers": [
      { "target": "ac", "op": "add", "value": 1, "when": "$owner.attuned" },
      { "target": "saves", "op": "add", "value": 1, "when": "$owner.attuned" }
    ]
  },
  "cloak_of_protection": {
