    ]
  },
  "bracers_of_defense": {
    "summary": "+2 AC without armor or shield",
    "modifiers": [
      { "target": "ac", "op": "add", "value": 2, "when": "$owner.attuned && !@armor_worn && !@shield_worn" }
    ]
  },
